{
  "schemaVersion": 1,
  "id": "dev.audiospan.gain-rust",
  "name": "Gain (Rust)",
  "version": "0.1.0",
  "vendor": "Audiospan",
  "description": "Reference linear gain effect implemented in Rust against the Audiospan ABI.",
  "category": "utility",
  "license": "MIT",
  "entry": {
    "wasm": "module.wasm",
    "abi": "audiospan-c"
  },
  "audio": {
    "inputs": [
      {
        "id": "in",
        "name": "Input",
        "channels": {
          "min": 1,
          "max": 2
        }
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "Output",
        "channels": {
          "min": 1,
          "max": 2
        }
      }
    ],
    "maxFramesPerProcess": 4096,
    "latencyFrames": 0
  },
  "parameters": [
    {
      "id": "gain",
      "name": "Gain",
      "type": "float",
      "unit": "linear",
      "min": 0.0,
      "max": 2.0,
      "default": 1.0,
      "step": 0.01,
      "display": {
        "style": "slider",
        "format": "linear",
        "precision": 2
      }
    }
  ],
  "outputs": [
    {
      "id": "level",
      "name": "Output level",
      "description": "Peak absolute sample of the last processed block.",
      "min": 0.0,
      "max": 2.0,
      "display": { "format": "linear", "precision": 2 }
    }
  ],
  "capabilities": {
    "state": true,
    "presets": true,
    "customUI": false,
    "midiInput": false,
    "sidechain": false,
    "network": false,
    "filesystem": false
  },
  "resources": {
    "maxMemoryBytes": 16777216,
    "maxStateBytes": 1048576,
    "maxAssetBytes": 1048576
  },
  "presets": [
    {
      "id": "default",
      "name": "Default",
      "path": "presets/default.json"
    },
    {
      "id": "half",
      "name": "Half",
      "path": "presets/half.json"
    },
    {
      "id": "boost",
      "name": "Boost",
      "path": "presets/boost.json"
    }
  ]
}
