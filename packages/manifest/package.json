{
  "name": "@audiospan/manifest",
  "version": "0.1.0",
  "description": "Audiospan plugin manifest types, JSON schema, and validation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/plugin.schema.json": "./schema/plugin.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json"
  }
}
