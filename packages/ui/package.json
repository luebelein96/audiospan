{
  "name": "@audiospan/ui",
  "version": "0.1.0",
  "description": "Framework-agnostic default parameter controls for Audiospan plugins.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": "./dist/audiospan-ui.bundle.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.json && node build-bundle.mjs",
    "bundle": "node build-bundle.mjs",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@audiospan/manifest": "workspace:*",
    "@audiospan/sdk": "workspace:*"
  }
}
